                    <span class="font-bold text-sm text-[#1E2229]">Facebook</span>
                </div>
                <div onclick="showToast('Instagram')" class="p-6 rounded-2xl bg-[#F8F9FA] border border-gray-200/60 hover:border-pink-500 hover:shadow-lg transition cursor-pointer group flex flex-col items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-pink-100 text-pink-600 flex items-center justify-center text-2xl group-hover:scale-110 transition"><i class="fa-brands fa-instagram"></i></div>
                    <span class="font-bold text-sm text-[#1E2229]">Instagram</span>
