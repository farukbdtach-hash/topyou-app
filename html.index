                                    <i class="fa-solid fa-arrow-right text-[#FF3B30]"></i>
                                </div>
                            </div>

                            <!-- Platforms Grid in App -->
                            <div class="px-3 py-2 bg-white border-b border-gray-100 flex items-center justify-between gap-2 overflow-x-auto">
                                <div class="flex flex-col items-center gap-1 flex-shrink-0">
                                    <div class="w-9 h-9 rounded-full bg-red-500 text-white flex items-center justify-center text-xs"><i class="fa-solid fa-play"></i></div>
                                    <span class="text-[9px] text-gray-600 font-medium">YouTube</span>
                                </div>
                                <div class="flex flex-col items-center gap-1 flex-shrink-0">
                                    <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs"><i class="fa-brands fa-facebook-f"></i></div>
                                    <span class="text-[9px] text-gray-600 font-medium">Facebook</span>
                                </div>
                                <div class="flex flex-col items-center gap-1 flex-shrink-0">
                                    <div class="w-9 h-9 rounded-full bg-pink-600 text-white flex items-center justify-center text-xs"><i class="fa-brands fa-instagram"></i></div>
                                    <span class="text-[9px] text-gray-600 font-medium">Insta</span>
                                </div>
                                <div class="flex flex-col items-center gap-1 flex-shrink-0">
                                    <div class="w-9 h-9 rounded-full bg-black text-white flex items-center justify-center text-xs"><i class="fa-brands fa-tiktok"></i></div>
                                    <span class="text-[9px] text-gray-600 font-medium">TikTok</span>
                                </div>
                            </div>

                            <!-- Feed Video Card -->
                            <div class="p-2 flex-1 overflow-y-auto space-y-3">
