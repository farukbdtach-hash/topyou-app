                <div onclick="showToast('TikTok')" class="p-6 rounded-2xl bg-[#F8F9FA] border border-gray-200/60 hover:border-black hover:shadow-lg transition cursor-pointer group flex flex-col items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-gray-100 text-black flex items-center justify-center text-2xl group-hover:scale-110 transition"><i class="fa-brands fa-tiktok"></i></div>
                    <span class="font-bold text-sm text-[#1E2229]">TikTok</span>
                </div>
                <div onclick="showToast('Twitter / X')" class="p-6 rounded-2xl bg-[#F8F9FA] border border-gray-200/60 hover:border-gray-800 hover:shadow-lg transition cursor-pointer group flex flex-col items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-gray-200 text-gray-900 flex items-center justify-center text-2xl group-hover:scale-110 transition"><i class="fa-brands fa-x-twitter"></i></div>
                    <span class="font-bold text-sm text-[#1E2229]">Twitter (X)</span>
                </div>
                <div onclick="showToast('WhatsApp Status')" class="p-6 rounded-2xl bg-[#F8F9FA] border border-gray-200/60 hover:border-emerald-500 hover:shadow-lg transition cursor-pointer group flex flex-col items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl group-hover:scale-110 transition"><i class="fa-brands fa-whatsapp"></i></div>
                    <span class="font-bold text-sm text-[#1E2229]">WhatsApp</span>
                </div>
