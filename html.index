    <!-- Core Features Section -->
    <section id="features" class="py-24 bg-[#F8F9FA]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-[#FF3B30] font-bold text-xs uppercase tracking-widest bg-red-50 px-3 py-1 rounded-full">Why Choose Toomate</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E2229] mt-3">Powerful Features Built for Android Users</h2>
                <p class="text-[#68707E] mt-3 text-sm sm:text-base">Experience unmatched downloading speed, offline playback, and crystal-clear media conversion.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition group">
                    <div class="w-14 h-14 rounded-2xl hero-gradient text-white flex items-center justify-center text-2xl mb-6 shadow-md group-hover:scale-110 transition">
                        <i class="fa-solid fa-bolt"></i>
