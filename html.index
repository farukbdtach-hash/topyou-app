                        <button onclick="triggerDownload(event)" class="w-full sm:w-auto hero-gradient text-white font-extrabold px-8 py-4 rounded-2xl shadow-2xl hover:opacity-95 transition flex items-center justify-center gap-3 text-lg pulse-btn group cursor-pointer">
                            <img src="https://i.imgur.com/okc1Qb3.png" alt="Logo" class="w-7 h-7 rounded-lg bg-white/20 p-1 object-contain group-hover:rotate-12 transition-transform">
                            <div class="text-left">
                                <div class="text-[11px] font-medium text-white/90 uppercase tracking-wider">Official Android Release</div>
                                <div class="text-base font-extrabold">Download Toomate APK (Free)</div>
                            </div>
                        </button>

