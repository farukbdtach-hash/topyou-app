    </section>

    <!-- Supported Platforms Showcase -->
    <section id="platforms" class="py-20 bg-white border-y border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl font-extrabold text-[#1E2229] mb-4">Download Videos from 1000+ Websites</h2>
            <p class="text-[#68707E] max-w-xl mx-auto mb-12 text-sm sm:text-base">Support for direct high-speed video extraction and MP3 conversion across top platforms.</p>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
                <div onclick="showToast('YouTube')" class="p-6 rounded-2xl bg-[#F8F9FA] border border-gray-200/60 hover:border-red-500 hover:shadow-lg transition cursor-pointer group flex flex-col items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-2xl group-hover:scale-110 transition"><i class="fa-brands fa-youtube"></i></div>
                    <span class="font-bold text-sm text-[#1E2229]">YouTube</span>
