                                    <i class="fa-solid fa-download text-xs"></i>
                                    <span class="text-[9px]">Downloads</span>
                                </div>
                                <div class="flex flex-col items-center text-gray-400">
                                    <i class="fa-solid fa-folder text-xs"></i>
