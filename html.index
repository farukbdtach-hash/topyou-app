                        <button onclick="openQRModal()" class="w-full sm:w-auto bg-white border border-gray-200 text-[#1E2229] font-bold px-6 py-4 rounded-2xl shadow-xs hover:bg-gray-50 transition flex items-center justify-center gap-2.5 text-base cursor-pointer">
                            <i class="fa-solid fa-qrcode text-[#FF3B30] text-xl"></i>
                            <span>Scan QR Code</span>
                        </button>
