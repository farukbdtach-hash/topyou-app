<!DOCTYPE html>
<html lang="bn" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Title & Description -->
    <title>Toomate - Best Free HD Video & Music Downloader for Android</title>
    <meta name="description" content="Download HD videos and MP3 music from YouTube, Facebook, Instagram, TikTok, and 1000+ websites instantly with Toomate Android app. Fast, free, and 100% safe." />
    
    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="WkewJoN7SwY5syPfeh5f55MX5clHbT069rSG8IkhO0w" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .hero-gradient { background: linear-gradient(135deg, #FF3B30 0%, #FF6B2B 100%); }
        .glass-nav { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); }
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
        }
        .animate-float { animation: float 4s ease-in-out infinite; }
        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 25px rgba(255, 59, 48, 0.5), 0 0 50px rgba(255, 107, 43, 0.3); transform: scale(1); }
            50% { box-shadow: 0 0 40px rgba(255, 59, 48, 0.9), 0 0 80px rgba(255, 107, 43, 0.6); transform: scale(1.03); }
        }
        .pulse-btn { animation: pulse-glow 2.2s infinite; }
    </style>
</head>
<body class="bg-[#F8F9FA] text-[#1E2229] antialiased selection:bg-[#FF3B30] selection:text-white">

    <!-- Sticky Glassmorphic Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 glass-nav border-b border-gray-100 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <img src="https://i.imgur.com/okc1Qb3.png" alt="Toomate Logo" class="w-10 h-10 rounded-xl object-contain shadow-md group-hover:scale-110 transition-transform">
                <span class="text-2xl font-extrabold tracking-tight text-[#1E2229]">Too<span class="text-[#FF3B30]">mate</span></span>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center gap-8 font-medium text-sm text-[#68707E]">
                <a href="#hero" class="hover:text-[#FF3B30] transition-colors">Home</a>
                <a href="#features" class="hover:text-[#FF3B30] transition-colors">Features</a>
                <a href="#platforms" class="hover:text-[#FF3B30] transition-colors">Supported Sites</a>
                <a href="#how-to-download" class="hover:text-[#FF3B30] transition-colors">How to Download</a>
                <a href="#faq" class="hover:text-[#FF3B30] transition-colors">FAQ</a>
            </nav>

            <!-- Right Actions -->
            <div class="hidden sm:flex items-center gap-4">
                <!-- Download CTA Button with Animation -->
                <a href="#hero" onclick="triggerDownload(event)" class="hero-gradient text-white font-bold px-6 py-2.5 rounded-full shadow-xl hover:opacity-95 transition flex items-center gap-2.5 text-sm pulse-btn">
                    <i class="fa-solid fa-download text-xs"></i>
                    <span>Download App</span>
                </a>
            </div>

            <!-- Mobile Menu Button -->
            <button id="menuBtn" class="md:hidden text-2xl text-[#1E2229] focus:outline-none">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <!-- Mobile Drawer -->
        <div id="mobileMenu" class="hidden md:hidden absolute top-20 left-0 w-full bg-white border-b border-gray-200 shadow-xl px-6 py-6 flex flex-col gap-4">
            <a href="#hero" class="mobile-link font-medium text-lg">Home</a>
            <a href="#features" class="mobile-link font-medium text-lg">Features</a>
            <a href="#platforms" class="mobile-link font-medium text-lg">Supported Sites</a>
            <a href="#how-to-download" class="mobile-link font-medium text-lg">How to Download</a>
            <a href="#faq" class="mobile-link font-medium text-lg">FAQ</a>
            <hr class="border-gray-100 my-2">
            <a href="#hero" onclick="triggerDownload(event)" class="hero-gradient text-white font-bold py-3 rounded-xl text-center flex items-center justify-center gap-2 shadow-md">
                <i class="fa-solid fa-download"></i>
                <span>Download Toomate APK</span>
            </a>
        </div>
    </header>

    <!-- Hero Section -->
