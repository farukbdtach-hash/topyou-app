    <!-- FAQ Accordion -->
    <section id="faq" class="py-24 bg-[#F8F9FA]">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-[#FF3B30] font-bold text-xs uppercase tracking-widest bg-red-50 px-3 py-1 rounded-full">FAQ</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E2229] mt-3">Frequently Asked Questions</h2>
            </div>

            <div class="space-y-4">
                <div class="bg-white rounded-2xl border border-gray-200/60 overflow-hidden shadow-xs">
                    <button onclick="toggleFAQ(this)" class="w-full px-6 py-5 text-left font-bold text-base text-[#1E2229] flex items-center justify-between focus:outline-none cursor-pointer">
                        <span>Is Toomate 100% safe to install?</span>
                        <i class="fa-solid fa-chevron-down text-gray-400 transition-transform"></i>
                    </button>
                    <div class="hidden px-6 pb-5 text-sm text-[#68707E] leading-relaxed">
                        Yes, Toomate is completely secure, malware-free, and trusted by millions of Android users worldwide.
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-200/60 overflow-hidden shadow-xs">
                    <button onclick="toggleFAQ(this)" class="w-full px-6 py-5 text-left font-bold text-base text-[#1E2229] flex items-center justify-between focus:outline-none cursor-pointer">
                        <span>Can I convert videos to MP3 audio?</span>
                        <i class="fa-solid fa-chevron-down text-gray-400 transition-transform"></i>
                    </button>
                    <div class="hidden px-6 pb-5 text-sm text-[#68707E] leading-relaxed">
                        Yes! Toomate has a built-in converter that extracts 320kbps high-quality MP3 audio from any link instantly.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pre-Footer CTA Banner -->
    <section class="py-20 hero-gradient text-white text-center relative overflow-hidden">
        <div class="max-w-4xl mx-auto px-4 relative z-10 space-y-6">
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Ready to Experience VidMate Style Speed?</h2>
            <p class="text-white/90 max-w-xl mx-auto text-sm sm:text-base">Download the official Toomate app now and enjoy unlimited media downloads.</p>
            <button onclick="triggerDownload(event)" class="inline-flex items-center gap-3 bg-white text-[#FF3B30] font-bold px-8 py-4 rounded-2xl shadow-2xl hover:bg-gray-100 transition text-lg transform hover:scale-105 cursor-pointer">
                <i class="fa-solid fa-download"></i>
                <span>Download Toomate APK Now</span>
            </button>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#14171D] text-gray-400 py-12 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
            <div class="flex items-center gap-3">
                <img src="https://i.imgur.com/okc1Qb3.png" alt="Logo" class="w-9 h-9 rounded-xl object-contain bg-white/10 p-1">
                <span class="text-xl font-bold text-white">Too<span class="text-[#FF3B30]">mate</span></span>
            </div>
            <div class="flex flex-wrap justify-center gap-6 text-xs text-gray-400 font-medium">
                <a href="#" class="hover:text-white transition">Privacy Policy</a>
                <a href="#" class="hover:text-white transition">Terms of Service</a>
                <a href="#" class="hover:text-white transition">Contact Us</a>
            </div>
            <div class="text-xs text-gray-500">
                © 2026 Toomate. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- QR Code Modal -->
    <div id="qrModal" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl p-8 max-w-sm w-full text-center relative shadow-2xl">
            <button onclick="closeQRModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg cursor-pointer"><i class="fa-solid fa-xmark"></i></button>
            <div class="w-16 h-16 rounded-2xl hero-gradient text-white mx-auto flex items-center justify-center text-3xl mb-4 shadow-md">
                <img src="https://i.imgur.com/okc1Qb3.png" class="w-10 h-10 object-contain rounded-lg">
            </div>
            <h3 class="text-xl font-bold text-[#1E2229] mb-2">Scan to Download</h3>
            <p class="text-xs text-[#68707E] mb-6">Scan with your mobile camera to get Toomate APK instantly.</p>
            <div class="bg-gray-100 p-4 rounded-2xl inline-block mb-6 border border-gray-200">
                <svg class="w-40 h-40 mx-auto" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="100" height="100" rx="12" fill="white"/>
                    <rect x="10" y="10" width="30" height="30" rx="6" fill="#1E2229"/>
                    <rect x="16" y="16" width="18" height="18" rx="3" fill="white"/>
                    <rect x="20" y="20" width="10" height="10" fill="#FF3B30"/>
                    <rect x="60" y="10" width="30" height="30" rx="6" fill="#1E2229"/>
                    <rect x="66" y="16" width="18" height="18" rx="3" fill="white"/>
                    <rect x="70" y="20" width="10" height="10" fill="#FF3B30"/>
                    <rect x="10" y="60" width="30" height="30" rx="6" fill="#1E2229"/>
                    <rect x="16" y="66" width="18" height="18" rx="3" fill="white"/>
                    <rect x="20" y="70" width="10" height="10" fill="#FF3B30"/>
                    <rect x="50" y="50" width="12" height="12" fill="#1E2229"/>
                    <rect x="70" y="50" width="20" height="10" fill="#1E2229"/>
                    <rect x="50" y="70" width="10" height="20" fill="#1E2229"/>
                    <rect x="70" y="70" width="20" height="20" rx="4" fill="#1E2229"/>
                </svg>
            </div>
            <div class="text-[11px] text-emerald-600 font-bold bg-emerald-50 py-2 rounded-xl">Official Release v4.0 • Secure APK</div>
        </div>
    </div>

    <!-- Download Progress Modal -->
    <div id="downloadModal" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl p-8 max-w-sm w-full text-center relative shadow-2xl">
            <div class="w-16 h-16 rounded-2xl hero-gradient text-white mx-auto flex items-center justify-center text-3xl mb-4 shadow-md animate-bounce">
                <img src="https://i.imgur.com/okc1Qb3.png" class="w-10 h-10 object-contain rounded-lg">
            </div>
            <h3 class="text-xl font-bold text-[#1E2229] mb-1">Downloading Toomate APK</h3>
            <p id="downloadStatusText" class="text-xs text-[#68707E] mb-6">Connecting to secure server...</p>
            <div class="w-full bg-gray-100 h-3 rounded-full overflow-hidden mb-4 border border-gray-200">
                <div id="progressBar" class="hero-gradient h-full w-0 transition-all duration-300"></div>
            </div>
            <div class="text-[11px] text-emerald-600 font-bold bg-emerald-50 py-2 rounded-xl flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-shield-check"></i> SHA-256 Verified Security
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 bg-[#1E2229] text-white px-5 py-3 rounded-2xl shadow-2xl z-50 transform translate-y-20 opacity-0 transition-all duration-300 flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-[#00C853] text-lg"></i>
        <div class="text-xs">
            <div class="font-bold" id="toastTitle">Platform Supported</div>
            <div class="text-gray-400" id="toastDesc">HD Video & MP3 extraction ready.</div>
        </div>
    </div>

    <!-- JavaScript Interactivity -->
    <script>
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        });

        function toggleFAQ(button) {
            const content = button.nextElementSibling;
            const icon = button.querySelector('i');
            content.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
        }

        function openQRModal() {
            document.getElementById('qrModal').classList.remove('hidden');
        }
        function closeQRModal() {
            document.getElementById('qrModal').classList.add('hidden');
        }

        function showToast(platform) {
            const toast = document.getElementById('toast');
            document.getElementById('toastTitle').innerText = platform + " Supported";
            document.getElementById('toastDesc').innerText = "Direct HD Video & MP3 extraction active.";
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function triggerDownload(e) {
            e.preventDefault();
            const modal = document.getElementById('downloadModal');
            const progressBar = document.getElementById('progressBar');
            const statusText = document.getElementById('downloadStatusText');
            
            modal.classList.remove('hidden');
            progressBar.style.width = '0%';
            statusText.innerText = "Connecting to secure server...";

            let progress = 0;
            const interval = setInterval(() => {
                progress += 25;
                progressBar.style.width = progress + '%';
                if(progress === 50) statusText.innerText = "Downloading Toomate-v4.apk (68.2 MB)...";
                if(progress === 75) statusText.innerText = "Finalizing security scan...";
                if(progress >= 100) {
                    clearInterval(interval);
                    statusText.innerText = "Download starting now!";
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        // Correct GitHub APK Download Link (v4):
                        window.location.href = "https://github.com/farukbdtach-hash/topyou-app/releases/download/v4/app-release.apk";
                    }, 1200);
                }
            }, 300);
        }
    </script>
</body>
</html>
